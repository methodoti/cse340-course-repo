<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    
    <h2><%= projectDetails.title %></h2>
    <p>Description: <%= projectDetails.description %></p>
    <p>Date: <%= projectDetails.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
    <p>Location: <%= projectDetails.location %></p>
    <p>Partner Organization: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a></p>

    <p>Categories:</p>
        <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>">#<%= category.name.toLowerCase() %></a>
        <% }); %>
</main>

<%- include('partials/footer') %>
